# STACKED Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI (server-side only — never in iOS app)
# Set in Supabase Edge Function secrets:
# supabase secrets set OPENAI_API_KEY=sk-proj-...
OPENAI_API_KEY=sk-proj-your-key-here

# RevenueCat
REVENUECAT_API_KEY=appl_your-key-here

# PostHog Analytics
POSTHOG_API_KEY=phc_your-key-here
POSTHOG_HOST=https://app.posthog.com

# Edge Functions Base URL
EDGE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1
